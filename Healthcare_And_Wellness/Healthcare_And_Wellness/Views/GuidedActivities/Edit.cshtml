@model GuidedActivity
@{
    ViewData["Title"] = "Edit Guided Activity";
}

<div class="container mt-5">
    <div class="card shadow p-4">
        <h2 class="text-warning text-center">Edit Activity</h2>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="ActivityId" />
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="VideoUrl" class="form-label"></label>
                <input asp-for="VideoUrl" class="form-control" />
            </div>
            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">Back</a>
                <button type="submit" class="btn btn-warning">Save Changes</button>
            </div>
        </form>
    </div>
</div>

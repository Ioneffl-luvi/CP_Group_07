@model GuidedActivity
@{
    ViewData["Title"] = "Delete Activity";
}

<div class="container mt-5">
    <div class="alert alert-danger">
        <h4>Are you sure you want to delete this activity?</h4>
        <p><strong>@Model.Title</strong></p>
        <form asp-action="DeleteConfirmed" asp-route-id="@Model.ActivityId" method="post">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-danger">Delete</button>
        </form>
    </div>
</div>

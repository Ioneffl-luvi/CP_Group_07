@{
    ViewBag.Title = "About Us";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="card-header text-white d-flex align-items-center"
             style="background: linear-gradient(90deg, #4A90E2, #007BFF); border-bottom: 4px solid #0056b3;">
            <i class="bi bi-info-circle-fill fs-3 me-3"></i>
            <div>
                <h3 class="mb-0 fw-bold">About Us</h3>
                <small class="text-white-50">Learn more about our project, team, and goals</small>
            </div>
        </div>

        <div class="card-body" style="background-color: #f0f4ff;">
            <p class="lead text-dark">
                <strong>Smart Medical Helpers</strong> is an innovative student-led capstone project from <strong>Conestoga College</strong>, designed to empower healthcare services through technology.
            </p>

            <p class="text-dark">
                Our digital platform enhances community healthcare access by offering:
            </p>

            <ul class="list-group list-group-flush mb-4">
                <li class="list-group-item bg-transparent"><strong>🩺 Healthcare Recruitment:</strong> Connecting professionals with clinics and hospitals across the community.</li>
                <li class="list-group-item bg-transparent"><strong>📅 Appointment Booking:</strong> Hassle-free scheduling and management for patients and providers.</li>
                <li class="list-group-item bg-transparent"><strong>💪 Wellness & Fitness Tools:</strong> Including BMI calculators, step tracking, and personalized activity logs.</li>
                <li class="list-group-item bg-transparent"><strong>🧠 Mental Health Resources:</strong> Access to guided activities, articles, community forums, and self-assessments.</li>
                <li class="list-group-item bg-transparent"><strong>💉 Safe Injection Site Management:</strong> Organizing services to support safe and informed usage.</li>
            </ul>

            <div class="p-3 rounded shadow-sm mb-4" style="background-color: #eaf0ff;">
                <h5 class="text-primary"><i class="bi bi-people-fill me-2"></i> Our Project Team</h5>
                <p><strong>Project Title:</strong> Recruitment and Management for Healthcare and Community Wellness</p>
                <p><strong>Team Members:</strong></p>
                <ul>
                    <li>Chun Man So</li>
                    <li>Lovepreet Singh</li>
                    <li>Fanjun Yu</li>
                    <li>Guilherme Almeida Mota</li>
                </ul>
                <p><strong>Instructor:</strong> Cryston Heaven</p>
            </div>

            <blockquote class="blockquote text-center mt-4">
                <p class="mb-0 text-primary fst-italic">"Technology should empower every patient, professional, and provider."</p>
                <footer class="blockquote-footer">Smart Medical Helpers</footer>
            </blockquote>
        </div>
    </div>
</div>

@model BmiCalculator

@{
    ViewData["Title"] = "BMI Calculator";
}

<div class="container mt-5">
    <h1 class="text-center text-primary mb-4">
        <i class="bi bi-calculator me-2"></i> BMI Calculator
    </h1>

    <form asp-controller="BmiCalculator" asp-action="BmiCalculation" method="post" class="shadow-sm p-4 rounded bg-white bg-opacity-75">
        <div asp-validation-summary="All" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="Height" class="form-label">Height (m)</label>
            <input type="text" class="form-control" asp-for="Height" placeholder="Enter height in meters">
            <span asp-validation-for="Height" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Weight" class="form-label">Weight (kg)</label>
            <input type="text" asp-for="Weight" class="form-control" placeholder="Enter weight in kilograms">
            <span asp-validation-for="Weight" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="BmiResult" class="form-label">BMI Result</label>
            <input type="text" asp-for="BmiResult" class="form-control" value="@Model.BmiResult?.ToString("0.00")" disabled>
        </div>

        <div class="d-flex flex-wrap justify-content-between gap-3">
            <button type="submit" name="actionType" value="calculate" class="btn btn-primary px-4">
                <i class="bi bi-play-fill me-1"></i> Calculate
            </button>
            <button type="submit" name="actionType" value="save" class="btn btn-success px-4">
                <i class="bi bi-save me-1"></i> Save BMI
            </button>
            <a asp-action="Index" class="btn btn-secondary px-4">
                <i class="bi bi-arrow-left me-1"></i> Back to Home
            </a>
        </div>
    </form>
</div>

@model List<Healthcare_And_Wellness.Models.WorkoutPlan>

<div class="container mt-5">
    <h2 class="text-center text-primary fw-bold mb-4">
        <i class="bi bi-dumbbell me-2 text-success"></i> Workout Plans
    </h2>

    @if (ViewBag.Role == "Admin")
    {
        <div class="text-end mb-4">
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Add New Workout
            </a>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center shadow-sm rounded-pill">
            <i class="bi bi-exclamation-circle me-2"></i> No workout plans available. Start adding new workouts!
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var workout in Model)
            {
                <div class="col">
                    <div class="card shadow-sm border-0 h-100 rounded-4">
                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="card-title fw-semibold text-primary mb-2">
                                <i class="bi bi-person-bounding-box me-2 text-success"></i> @workout.Title
                            </h5>

                            <p class="card-text text-muted small mb-3">@workout.Description</p>

                            <div class="mb-3">
                                <span class="badge bg-secondary me-1">
                                    <i class="bi bi-tags me-1"></i> @workout.Category
                                </span>
                                <span class="badge bg-success">
                                    <i class="bi bi-clock me-1"></i> @workout.Duration min
                                </span>
                            </div>

                            @if (!string.IsNullOrEmpty(workout.VideoUrl))
                            {
                                <div class="mb-3">
                                    <a href="@workout.VideoUrl" target="_blank" class="btn btn-outline-info w-100 shadow-sm">
                                        <i class="bi bi-play-circle me-1"></i> Watch Video
                                    </a>
                                </div>
                            }

                            <a asp-action="StartWorkout" asp-route-id="@workout.WorkoutId" class="btn btn-success mb-2 w-100 shadow-sm">
                                <i class="bi bi-play-fill me-1"></i> Start Workout
                            </a>

                            @if (ViewBag.Role == "Admin")
                            {
                                <div class="d-flex justify-content-between mt-auto">
                                    <a asp-action="Edit" asp-route-id="@workout.WorkoutId" class="btn btn-warning btn-sm px-3 shadow-sm">
                                        <i class="bi bi-pencil-square me-1"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@workout.WorkoutId" class="btn btn-danger btn-sm px-3 shadow-sm">
                                        <i class="bi bi-trash me-1"></i> Delete
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

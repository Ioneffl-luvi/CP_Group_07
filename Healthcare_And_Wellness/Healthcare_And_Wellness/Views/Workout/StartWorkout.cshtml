@model Healthcare_And_Wellness.Models.WorkoutPlan

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-gradient text-white text-center py-4" style="background: linear-gradient(to right, #007bff, #00bfff);">
                    <h2 class="mb-0">
                        <i class="bi bi-stopwatch me-2"></i> Workout Timer
                    </h2>
                </div>
                <div class="card-body p-5 text-center bg-white bg-opacity-75">

                    <h3 class="text-success fw-bold mb-2">
                        <i class="bi bi-person-bounding-box me-2"></i>@Model.Title
                    </h3>
                    <p class="text-muted mb-4">@Model.Description</p>

                    <div class="timer-container mb-4">
                        <h1 id="timer-display" class="fw-bold text-danger display-3">
                            @($"{Model.Duration}:00")
                        </h1>
                        <p class="text-muted">Time remaining</p>
                    </div>

                    <div class="d-flex flex-wrap justify-content-center gap-3">
                        <button onclick="startTimer()" class="btn btn-success btn-lg shadow-sm px-4">
                            <i class="bi bi-play-fill me-1"></i> Start
                        </button>
                        <button onclick="pauseTimer()" class="btn btn-warning btn-lg shadow-sm px-4">
                            <i class="bi bi-pause-circle me-1"></i> Pause
                        </button>
                        <button onclick="resetTimer()" class="btn btn-danger btn-lg shadow-sm px-4">
                            <i class="bi bi-arrow-clockwise me-1"></i> Reset
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    let timer, timeLeft = @Model.Duration * 60, isRunning = false;
    const timerDisplay = document.getElementById('timer-display');
    const beep = new Audio('https://www.soundjay.com/button/beep-07.wav');

    function startTimer() {
        if (!isRunning) {
            isRunning = true;
            timer = setInterval(() => {
                let minutes = Math.floor(timeLeft / 60);
                let seconds = timeLeft % 60;
                timerDisplay.innerText = `${minutes}:${seconds.toString().padStart(2, '0')}`;
                if (timeLeft <= 0) {
                    clearInterval(timer);
                    beep.play(); // Play sound when workout ends
                    timerDisplay.innerText = "🏆 Completed!";
                }
                timeLeft--;
            }, 1000);
        }
    }

    function pauseTimer() {
        clearInterval(timer);
        isRunning = false;
    }

    function resetTimer() {
        clearInterval(timer);
        timeLeft = @Model.Duration * 60;
        isRunning = false;
        timerDisplay.innerText = "@($"{Model.Duration}:00")";
    }
</script>

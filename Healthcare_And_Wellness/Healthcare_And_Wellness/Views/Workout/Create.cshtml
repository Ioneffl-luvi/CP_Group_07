@model Healthcare_And_Wellness.Models.WorkoutPlan

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center">
                    <h2 class="mb-0"><i class="bi bi-plus-circle"></i> Create New Workout</h2>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-info text-center">
                        <i class="bi bi-info-circle"></i> Design your workout and keep users motivated! 🚀
                    </div>

                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">🏋️ Workout Title</label>
                            <input asp-for="Title" class="form-control border-primary" placeholder="Enter workout title" required />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">📝 Description</label>
                            <textarea asp-for="Description" class="form-control border-primary" rows="4"
                                      placeholder="Enter workout description" required></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Category" class="form-label fw-bold">📌 Category</label>
                            <select asp-for="Category" class="form-select border-primary" required>
                                <option value="" selected disabled>Choose a category...</option>
                                <option value="Strength">💪 Strength</option>
                                <option value="Cardio">🏃 Cardio</option>
                                <option value="Yoga">🧘 Yoga</option>
                                <option value="HIIT">🔥 HIIT</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Duration" class="form-label fw-bold">⏳ Duration (minutes)</label>
                            <input asp-for="Duration" type="number" class="form-control border-primary" min="1" required />
                            <span asp-validation-for="Duration" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="VideoUrl" class="form-label fw-bold">🎥 Video URL (Optional)</label>
                            <input asp-for="VideoUrl" type="url" class="form-control border-primary" placeholder="Enter YouTube or Vimeo link" />
                        </div>

                        <div class="d-flex justify-content-center gap-3">
                            <a asp-action="Index" class="btn btn-secondary px-4">
                                <i class="bi bi-arrow-left"></i> Back to Workouts
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save"></i> Save Workout
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

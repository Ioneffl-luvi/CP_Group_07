@model Healthcare_And_Wellness.Models.Injection
@{
    ViewData["Title"] = "Delete Injection";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-danger text-white text-center py-3">
                    <h4 class="mb-0"><i class="bi bi-trash-fill me-2"></i>Confirm Deletion</h4>
                </div>
                <div class="card-body bg-white p-4">

                    <p class="lead text-center text-muted mb-4">
                        Are you sure you want to permanently delete the following injection?
                    </p>

                    <ul class="list-group list-group-flush mb-4">
                        <li class="list-group-item d-flex justify-content-between">
                            <strong>Type:</strong> <span>@Model.Type</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <strong>Name:</strong> <span>@Model.Name</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <strong>Location:</strong> <span>@Model.Location</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <strong>Time:</strong> <span>@Model.Time.ToString("yyyy-MM-dd HH:mm")</span>
                        </li>
                    </ul>

                    <form asp-action="DeleteConfirmed" method="post">
                        <input type="hidden" name="id" value="@Model.InjectionId" />
                        <div class="d-flex justify-content-center gap-3">
                            <button type="submit" class="btn btn-danger px-4 shadow-sm">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                            <a asp-action="Index" class="btn btn-secondary px-4 shadow-sm">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

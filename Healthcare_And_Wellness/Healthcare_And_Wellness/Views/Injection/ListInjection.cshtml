@model List<Reservation>
@{
    ViewData["Title"] = "Injection Reservations";
}

<div class="container mt-5">
    <h2 class="text-center text-primary fw-bold mb-4">
        <i class="bi bi-journal-text me-2 text-success"></i> Injection Reservations
    </h2>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center rounded-pill shadow-sm">
            <i class="bi bi-exclamation-circle me-2"></i> No reservations found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle shadow-sm">
                <thead class="table-primary text-center">
                    <tr>
                        <th>User Name</th>
                        <th>Injection Type</th>
                        <th>Injection Name</th>
                        <th>Add Time</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var injection in Model)
                    {
                        <tr class="text-center">
                            <td>@injection.User.Username</td>
                            <td>@injection.Injection.Type</td>
                            <td>@injection.Injection.Name</td>
                            <td>@injection.AddTime.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

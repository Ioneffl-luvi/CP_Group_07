<!-- Edit Appointment Page -->
@model Healthcare_And_Wellness.Models.Appointment
@{
    ViewData["Title"] = "Edit Appointment";
}

<div class="container mt-5">
    <div class="card shadow-lg">
        <div class="card-body">
            <h2 class="text-center text-warning fw-bold">Edit Appointment</h2>
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label class="form-label">Date & Time</label>
                    <input type="datetime-local" asp-for="AppointmentDate" class="form-control" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Service Type</label>
                    <input type="text" asp-for="ServiceType" class="form-control" required>
                </div>

                <button type="submit" class="btn btn-warning w-100"><i class="bi bi-save"></i> Update</button>
            </form>
        </div>
    </div>
</div>

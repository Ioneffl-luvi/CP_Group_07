<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <div class="page-background"></div>
    <div class="background-fade-layer"></div>
    <nav class="navbar navbar-expand-lg shadow-sm" style="background: linear-gradient(90deg, #4A90E2, #007BFF);">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <img src="~/ProfilePics/Logo.png" alt="Logo" style="height: 60px; width: 60px;">
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-semibold text-white">
                    <li class="nav-item dropdown">
                        <a class="nav-link text-white dropdown-toggle" href="#" id="infoDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Info
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="infoDropdown">
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Help">Help</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="HowToUse">How to Use</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="AboutUs">About Us</a></li>
                        </ul>
                    </li>
                    @if (string.IsNullOrEmpty(ViewBag.Username))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Home">Home Page</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Account" asp-action="Register">Register</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Account" asp-action="Login">Login</a>
                        </li>
                    }

                    @if (!string.IsNullOrEmpty(ViewBag.Username) && ViewBag.IsResetPasswordPage != true)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Welcome Page</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Account" asp-action="Profile">Profile</a>
                        </li>
                        @if (ViewBag.Role == "Admin")
                        {
                            <li><a class="nav-link text-white" asp-controller="Account" asp-action="ViewUsers">View Users</a></li>
                            <li class="nav-item dropdown">
                                <a class="nav-link text-white dropdown-toggle" href="#" id="jobDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                 Management
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="jobDropdown">
                                    <li><a class="dropdown-item" asp-controller="Administrator" asp-action="AddJobs">Add Job</a></li>
                                    <li><a class="dropdown-item" asp-controller="Administrator" asp-action="ListJobs">List Jobs</a></li>
                                    <li><a class="dropdown-item" asp-controller="Articles" asp-action="Index">Educational Materials</a></li>
                                    <li><a class="dropdown-item" asp-controller="Workout" asp-action="Index">Workout</a></li>
                                    <li><a class="dropdown-item" asp-controller="Appointment" asp-action="Index">Manage Appointments</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link text-white dropdown-toggle" href="#" id="jobDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Safe Injection Site
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="jobDropdown">
                                    <li><a class="dropdown-item" asp-controller="Injection" asp-action="Index">Injections</a></li>
                                    <li><a class="dropdown-item" asp-controller="Injection" asp-action="ListInjection">List Injections</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link text-white dropdown-toggle" href="#" id="jobDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Mental Health
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="jobDropdown">
                                    <li><a class="dropdown-item" asp-controller="MentalArticles" asp-action="Index">Mental Articles</a></li>
                                    <li><a class="dropdown-item" asp-controller="MentalArticles" asp-action="Create">Create Mental Articles</a></li>
                                    <li><a class="dropdown-item" asp-controller="GuidedActivities" asp-action="Index">Guided activities</a></li>
                                    <li><a class="dropdown-item" asp-controller="GuidedActivities" asp-action="Create">Create Guided activities</a></li>
                                    <li><a class="dropdown-item" asp-controller="SupportPosts" asp-action="Index">Support Posts</a></li>
                                </ul>
                            </li>
                        }
                        else if (ViewBag.Role == "Member")
                        {
                            <!-- Dropdown for Admin Job Management -->
                            <li class="nav-item dropdown">
                                <a class="nav-link text-white dropdown-toggle" href="#" id="jobDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Job Management
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="jobDropdown">
                                    <li><a class="dropdown-item" asp-controller="Applicant" asp-action="ListJobs">List of Jobs</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link text-white dropdown-toggle" href="#" id="jobDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Healthcare Tools
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="jobDropdown">
                                    <li><a class="dropdown-item" asp-controller="BmiCalculator" asp-action="Index">BMI Calculator</a></li>
                                    <li><a class="dropdown-item" asp-controller="Articles" asp-action="Index">Educational Materials</a></li>
                                    <li><a class="dropdown-item" asp-controller="Workout" asp-action="Index">Workout</a></li>
                                    <li><a class="dropdown-item" asp-controller="StepTracker" asp-action="Index">Step Tracking</a></li>
                                    <li><a class="dropdown-item" asp-controller="Appointment" asp-action="Index">View Appointments</a></li>
                                    <li><a class="dropdown-item" asp-controller="Appointment" asp-action="Book">Book Appointments</a></li>
                                    <li><a class="dropdown-item" asp-controller="Recommendation" asp-action="Index">Recommendation</a></li>
                                </ul>                    
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link text-white dropdown-toggle" href="#" id="jobDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Safe Injection Site
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="jobDropdown">
                                    <li><a class="dropdown-item" asp-controller="Injection" asp-action="Index">Injections</a></li>
                                    <li><a class="dropdown-item" asp-controller="Injection" asp-action="ListInjection">List Injections</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link text-white dropdown-toggle" href="#" id="jobDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Mental Health
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="jobDropdown">
                                    <li><a class="dropdown-item" asp-controller="MentalArticles" asp-action="Index">Mental Articles</a></li>
                                    <li><a class="dropdown-item" asp-controller="GuidedActivities" asp-action="Index">Guided activities</a></li>
                                    <li><a class="dropdown-item" asp-controller="SelfAssessments" asp-action="Index">Self Assessment</a></li>
                                    <li><a class="dropdown-item" asp-controller="SupportPosts" asp-action="Index">Support Posts</a></li>
                                </ul>
                            </li>
                        }
                    }

                </ul>
                @if (!string.IsNullOrEmpty(ViewBag.Username) && ViewBag.IsResetPasswordPage != true)
                {
                    <div class="dropdown user-profile">
                        <a class="d-flex align-items-center text-decoration-none dropdown-toggle" role="button" id="dropdownUser" data-bs-toggle="dropdown" aria-expanded="false">
                            @{
                                var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                            }
                            @if (currentAction == "Index" && currentController == "Home" || currentAction == "Profile" && currentController == "Account")
                            {
                                @if (!string.IsNullOrEmpty(Model.ProfilePic))
                                {
                                    <img src="@Url.Action("DisplayProfilePic", "Account", new { id = Model.Id })" alt="Profile Picture" class="rounded-circle img-fluid" style="width: 50px; height: 50px; object-fit: cover;" />
                                }
                                else
                                {
                                    <img src="/ProfilePics/default_user.png" alt="Default Profile Picture" class="rounded-circle img-fluid" style="width: 50px; height: 50px; object-fit: cover;" />
                                }
                            }
                            <h6 class="ms-2 text-white fw-semibold">@ViewBag.UserName</h6>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" style="background-color: #f0f4ff;" aria-labelledby="dropdownUser">
                            <li>
                                <a class="dropdown-item text-primary fw-semibold" asp-controller="Account" asp-action="Profile">
                                    <i class="bi bi-person-circle me-2"></i> Profile
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item text-danger fw-semibold" asp-controller="Account" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i> Log Out
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item text-success fw-semibold" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus-fill me-2"></i> Create New Account
                                </a>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </nav>
    <div class="content-wrapper flex-grow-1 py-4">
        @RenderBody()
    </div>
    <footer class="py-4" style="background: linear-gradient(90deg, #4A90E2, #007BFF);">
        <div class="container text-center text-white">
            <span>&copy; 2025 <strong>Smart Medical Helpers</strong>. All rights reserved.</span>
        </div>
    </footer>
    @RenderSection("Scripts", required: false)
    <script src="~/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</body>
</html>

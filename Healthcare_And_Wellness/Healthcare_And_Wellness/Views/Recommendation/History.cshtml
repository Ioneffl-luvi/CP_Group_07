@model List<Healthcare_And_Wellness.Models.HealthRecommendation>
@{
    ViewData["Title"] = "Recommendation History";
}

<div class="container mt-5 mb-5">
    <h2 class="text-center text-success fw-bold mb-4">📜 Your Recommendation History</h2>

    @if (!Model.Any())
    {
        <p class="text-muted text-center fs-5">You have no previous recommendations.</p>
    }
    else
    {
        <ul class="list-group shadow-sm">
            @foreach (var rec in Model)
            {
                <li class="list-group-item py-3 px-4">
                    <div class="fw-semibold text-secondary small mb-1">
                        <i class="bi bi-clock"></i> @rec.GeneratedAt.ToString("f")
                    </div>
                    <pre class="mb-0" style="white-space: pre-wrap; font-size: 1rem;">@rec.RecommendationText</pre>
                </li>
            }
        </ul>
    }

    <div class="text-center mt-5">
        <a asp-action="Index" class="btn btn-primary btn-lg px-4">
            <i class="bi bi-lightbulb-fill"></i> Generate New Recommendation
        </a>
    </div>
</div>

@model List<MentalArticle>
@{
    ViewData["Title"] = "Mental Articles";
    var isAdmin = Context.Session.GetString("Role") == "Admin";
}

<div class="container mt-5">
    <h2 class="text-center text-primary fw-bold mb-4">
        <i class="bi bi-journal-richtext me-2 text-secondary"></i> Mental Wellness Articles
    </h2>

    @if (isAdmin)
    {
        <div class="text-end mb-4">
            <a asp-action="Create" class="btn btn-success shadow-sm">
                <i class="bi bi-upload me-1"></i> Upload New Article
            </a>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center rounded-pill shadow-sm">
            <i class="bi bi-exclamation-circle me-2"></i> No articles available at the moment.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-4">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-semibold text-primary">
                                <i class="bi bi-bookmark-heart-fill me-2 text-success"></i>@item.Title
                            </h5>
                            <p class="text-muted small mb-3">Published on: @item.PublishedDate.ToString("MMMM dd, yyyy")</p>

                            <div class="d-flex flex-wrap gap-2 mt-auto">
                                <a asp-action="ViewPage" asp-route-fileName="@item.FileName" class="btn btn-primary btn-sm shadow-sm">
                                    <i class="bi bi-eye"></i> View Inline
                                </a>
                                <a asp-action="ReadableView" asp-route-fileName="@item.FileName" class="btn btn-warning btn-sm shadow-sm">
                                    🗣️ Read Aloud
                                </a>
                                <a asp-action="ViewPdf" asp-route-fileName="@item.FileName" target="_blank" class="btn btn-outline-secondary btn-sm shadow-sm">
                                    <i class="bi bi-box-arrow-up-right"></i> Open in Tab
                                </a>

                                @if (isAdmin)
                                {
                                    <a asp-action="Delete" asp-route-id="@item.ArticleId" class="btn btn-danger btn-sm shadow-sm ms-auto">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

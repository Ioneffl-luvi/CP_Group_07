@model Healthcare_And_Wellness.Models.Article

@{
    ViewBag.Title = "Delete Article";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-danger text-white">
            <h2 class="mb-0"><i class="bi bi-trash"></i> Delete Article</h2>
        </div>
        <div class="card-body p-4">
            <h4>Are you sure you want to delete this article?</h4>

            <dl class="row mt-4">
                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9">@Model.Title</dd>

                <dt class="col-sm-3">Published Date</dt>
                <dd class="col-sm-9">@Model.PublishedDate.ToShortDateString()</dd>

                <dt class="col-sm-3">Content</dt>
                <dd class="col-sm-9">@Model.Content</dd>
            </dl>

            <form asp-action="DeleteConfirmed" method="post">
                <input type="hidden" name="id" value="@Model.ArticleId" />
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Confirm Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@model List<Article>

@{
    ViewBag.Title = "Educational Articles";
}

<div class="container mt-5">
    <h2 class="text-center text-primary fw-bold mb-4">
        <i class="bi bi-journal-bookmark-fill me-2 text-secondary"></i> Educational Articles
    </h2>

    @if (ViewBag.Role == "Admin")
    {
        <div class="text-end mb-4">
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Add New Article
            </a>
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info text-center shadow-sm rounded-pill">
            <i class="bi bi-info-circle me-2"></i> No articles available at the moment.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var article in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-4">
                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="card-title fw-semibold text-primary">
                                <i class="bi bi-book-fill me-2 text-success"></i> @article.Title
                            </h5>
                            <p class="text-muted small mb-4">Published on: @article.PublishedDate.ToString("MMMM dd, yyyy")</p>

                            <div class="mt-auto d-flex flex-wrap gap-2">
                                <a asp-action="Details" asp-route-id="@article.ArticleId" class="btn btn-outline-primary btn-sm shadow-sm">
                                    <i class="bi bi-book"></i> Read
                                </a>

                                @if (ViewBag.Role == "Admin")
                                {
                                    <a asp-action="Edit" asp-route-id="@article.ArticleId" class="btn btn-outline-warning btn-sm shadow-sm">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@article.ArticleId" class="btn btn-outline-danger btn-sm shadow-sm">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

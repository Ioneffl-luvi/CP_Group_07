@model Healthcare_And_Wellness.Models.StepLog

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-danger text-white text-center">
                    <h3 class="mb-0"><i class="bi bi-trash3-fill"></i> Confirm Delete</h3>
                </div>
                <div class="card-body p-4 text-center">
                    <h5 class="mb-3 text-danger">⚠️ Are you sure you want to delete this step log?</h5>

                    <div class="alert alert-light border">
                        <dl class="row">
                            <dt class="col-sm-4 text-muted">📅 Date</dt>
                            <dd class="col-sm-8"><span class="badge bg-secondary">@Model.Date.ToShortDateString()</span></dd>

                            <dt class="col-sm-4 text-muted">🚶 Steps</dt>
                            <dd class="col-sm-8"><span class="badge bg-primary">@Model.Steps</span></dd>

                            <dt class="col-sm-4 text-muted">🔥 Calories Burned</dt>
                            <dd class="col-sm-8"><span class="badge bg-success">@Model.CaloriesBurned</span></dd>
                        </dl>
                    </div>

                    <form asp-action="DeleteConfirmed" method="post">
                        <input type="hidden" name="id" value="@Model.LogId" />
                        <div class="d-flex justify-content-center gap-3">
                            <a asp-action="Index" class="btn btn-secondary px-4">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-trash-fill"></i> Confirm Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@model Healthcare_And_Wellness.Models.StepLog

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center">
                    <h3 class="mb-0"><i class="bi bi-pencil-square"></i> Log Your Steps</h3>
                </div>
                <div class="card-body p-4">

                    <div class="alert alert-info text-center">
                        <i class="bi bi-info-circle"></i> Keep track of your steps and stay motivated! 🚀
                    </div>

                    <form asp-action="LogSteps" method="post">
                        <div class="mb-3">
                            <label asp-for="Steps" class="form-label fw-bold">🚶 Steps Taken</label>
                            <input asp-for="Steps" class="form-control form-control-lg border-primary"
                                   type="number" min="1" placeholder="Enter number of steps" required />
                            <span asp-validation-for="Steps" class="text-danger"></span>
                        </div>

                        <div class="progress mb-3" style="height: 10px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-success"
                                 role="progressbar" style="width: 50%;" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100">
                            </div>
                        </div>

                        <div class="d-flex justify-content-center gap-3">
                            <a asp-action="Index" class="btn btn-secondary px-4">
                                <i class="bi bi-arrow-left"></i> Back
                            </a>
                            <button type="submit" class="btn btn-success px-4">
                                <i class="bi bi-save"></i> Save Log
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

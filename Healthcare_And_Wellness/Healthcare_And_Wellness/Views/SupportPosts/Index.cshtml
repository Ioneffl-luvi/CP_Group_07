@model List<SupportPost>
@{
    ViewData["Title"] = "Community Support Forum";
    var currentUserId = Context.Session.GetString("UserId");
    var userRole = Context.Session.GetString("Role");
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-4">
        <h2 class="text-primary fw-bold"><i class="bi bi-chat-left-text me-2"></i>Community Support Forum</h2>
        <p class="text-muted">Share anonymously or openly with the community. You're not alone 💚</p>
    </div>

    <!-- Search + New Post -->
    <div class="row mb-4">
        <div class="col-md-8">
            <form method="get" asp-action="Index" class="input-group shadow-sm">
                <input type="text" name="keyword" class="form-control rounded-start" placeholder="Search posts..." value="@Context.Request.Query["keyword"]" />
                <button type="submit" class="btn btn-primary rounded-end">🔍 Search</button>
            </form>
        </div>
        <div class="col-md-4 text-end mt-3 mt-md-0">
            <a asp-action="Create" class="btn btn-success shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> New Post
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center shadow-sm rounded-pill">
            <i class="bi bi-info-circle me-1"></i> No posts yet. Be the first to share something!
        </div>
    }
    else
    {
        @foreach (var post in Model)
        {
            var likeCount = post.Reactions?.Count(r => r.ReactionType == "Like") ?? 0;
            var loveCount = post.Reactions?.Count(r => r.ReactionType == "Love") ?? 0;
            var supportCount = post.Reactions?.Count(r => r.ReactionType == "Support") ?? 0;

            <div class="card mb-4 shadow-sm border-0 rounded-4">
                <div class="card-body">
                    <p class="card-text fs-5">@post.Content</p>

                    <div class="d-flex flex-wrap justify-content-between text-muted small mb-2">
                        <div>
                            Posted by: <strong>@(post.IsAnonymous ? "Anonymous" : post.User?.Username ?? "Unknown")</strong>
                            • @post.PostedAt.ToString("yyyy-MM-dd HH:mm")
                            @if (post.IsPinned)
                            {
                                <span class="badge bg-warning text-dark ms-2">📌 Pinned</span>
                            }
                        </div>
                    </div>

                    <!-- Reactions & Actions -->
                    <div class="mt-3 d-flex flex-wrap gap-2">
                        <form asp-action="React" method="post">
                            <input type="hidden" name="postId" value="@post.PostId" />
                            <input type="hidden" name="type" value="Like" />
                            <button class="btn btn-outline-primary btn-sm @(post.Reactions?.Any(r => r.UserId.ToString() == currentUserId && r.ReactionType == "Like") == true ? "active" : "")" type="submit">
                                👍 Like (@likeCount)
                            </button>
                        </form>

                        <form asp-action="React" method="post">
                            <input type="hidden" name="postId" value="@post.PostId" />
                            <input type="hidden" name="type" value="Love" />
                            <button class="btn btn-outline-danger btn-sm @(post.Reactions?.Any(r => r.UserId.ToString() == currentUserId && r.ReactionType == "Love") == true ? "active" : "")" type="submit">
                                ❤️ Love (@loveCount)
                            </button>
                        </form>

                        <form asp-action="React" method="post">
                            <input type="hidden" name="postId" value="@post.PostId" />
                            <input type="hidden" name="type" value="Support" />
                            <button class="btn btn-outline-success btn-sm @(post.Reactions?.Any(r => r.UserId.ToString() == currentUserId && r.ReactionType == "Support") == true ? "active" : "")" type="submit">
                                🤝 Support (@supportCount)
                            </button>
                        </form>

                        @if (userRole == "Admin")
                        {
                            <form asp-action="Pin" method="post">
                                <input type="hidden" name="id" value="@post.PostId" />
                                <button class="btn btn-outline-warning btn-sm" type="submit">
                                    @(post.IsPinned ? "📌 Unpin" : "📌 Pin")
                                </button>
                            </form>
                        }

                        @if (currentUserId == post.UserId?.ToString() || userRole == "Admin")
                        {
                            <a asp-action="Delete" asp-route-id="@post.PostId" class="btn btn-outline-danger btn-sm">🗑️ Delete</a>
                        }

                        <button type="button" class="btn btn-outline-warning btn-sm" data-bs-toggle="modal" data-bs-target="#reportModal-@post.PostId">
                            🚩 Report
                        </button>
                    </div>

                    <!-- Comments -->
                    <hr />
                    <h6 class="fw-semibold mb-3">💬 Comments</h6>

                    <form asp-action="Comment" method="post" class="mb-3">
                        <input type="hidden" name="postId" value="@post.PostId" />
                        <textarea name="content" rows="2" class="form-control mb-2" placeholder="Write a comment..." required></textarea>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="isAnonymous" id="anon-@post.PostId" />
                            <label class="form-check-label" for="anon-@post.PostId">Post as anonymous</label>
                        </div>
                        <button type="submit" class="btn btn-outline-secondary btn-sm">💬 Comment</button>
                    </form>

                    @if (post.Comments?.Any() == true)
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var comment in post.Comments.OrderByDescending(c => c.CommentedAt))
                            {
                                <li class="list-group-item">
                                    <strong>@(comment.IsAnonymous ? "Anonymous" : comment.User?.Username ?? "User")</strong>
                                    <span class="text-muted small ms-2">@comment.CommentedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                    <p class="mb-0 mt-1">@comment.Content</p>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <!-- Report Modal -->
            <div class="modal fade" id="reportModal-@post.PostId" tabindex="-1" aria-labelledby="reportModalLabel-@post.PostId" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form asp-action="Report" method="post">
                            <input type="hidden" name="postId" value="@post.PostId" />
                            <div class="modal-header">
                                <h5 class="modal-title" id="reportModalLabel-@post.PostId">🚩 Report Post</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <textarea name="reason" class="form-control" rows="4" placeholder="Why are you reporting this post?" required></textarea>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-danger">Submit Report</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>

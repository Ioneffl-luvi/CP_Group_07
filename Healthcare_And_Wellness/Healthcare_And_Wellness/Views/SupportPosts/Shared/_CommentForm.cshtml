@model SupportPost
@{
    var userId = Context.Session.GetString("UserId");
}

<hr />
<h6 class="text-muted">Comments</h6>

@foreach (var comment in Model.Comments.OrderByDescending(c => c.CommentedAt))
{
    <div class="mb-2 p-2 border rounded bg-light">
        <small class="text-dark">@comment.Content</small><br />
        <small class="text-muted">
            by @(comment.IsAnonymous ? "Anonymous" : comment.User?.Username ?? "Unknown")
            | @comment.CommentedAt.ToString("yyyy-MM-dd HH:mm")
        </small>
    </div>
}

<form asp-action="Comment" method="post" class="mt-2">
    <input type="hidden" name="postId" value="@Model.PostId" />
    <div class="mb-2">
        <textarea name="content" class="form-control" placeholder="Add a comment..." required></textarea>
    </div>
    <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" name="isAnonymous" value="true" id="anon-@Model.PostId" />
        <label class="form-check-label" for="anon-@Model.PostId">Post as anonymous</label>
    </div>
    <button class="btn btn-sm btn-outline-secondary">Post Comment</button>
</form>

@model SupportPost

<!-- Button to trigger modal -->
<button type="button" class="btn btn-outline-warning btn-sm" data-bs-toggle="modal" data-bs-target="#reportModal-@Model.PostId">
    🚩 Report
</button>

<!-- Modal -->
<div class="modal fade" id="reportModal-@Model.PostId" tabindex="-1" aria-labelledby="reportModalLabel-@Model.PostId" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Report" method="post">
                <input type="hidden" name="postId" value="@Model.PostId" />
                <div class="modal-header">
                    <h5 class="modal-title" id="reportModalLabel-@Model.PostId">Report Post</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <textarea name="reason" class="form-control" rows="4" placeholder="Why are you reporting this post?" required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Submit Report</button>
                </div>
            </form>
        </div>
    </div>
</div>

@model List<Healthcare_And_Wellness.Models.User>

@{
    ViewBag.Title = "All Registered Users";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="card-header text-white" style="background: linear-gradient(90deg, #4A90E2, #007BFF);">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0"><i class="bi bi-people-fill me-2"></i> All Registered Users</h4>
            </div>
        </div>

        <div class="card-body bg-white p-4">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <table class="table table-hover align-middle table-bordered rounded-3 overflow-hidden shadow-sm">
                <thead style="background-color: #e6f0ff;">
                    <tr class="text-center fw-bold text-primary">
                        <th>Avatar</th>
                        <th>Username</th>
                        <th>Name</th>
                        <th>Age</th>
                        <th>Date of Birth</th>
                        <th>Role</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr class="text-center">
                            <td>
                                <div class="rounded-circle bg-info text-white d-flex align-items-center justify-content-center mx-auto"
                                     style="width: 40px; height: 40px; font-size: 1rem; font-weight: 600;">
                                    @user.Username.Substring(0, 1).ToUpper()
                                </div>
                            </td>
                            <td class="fw-semibold text-dark">@user.Username</td>
                            <td>@user.Name</td>
                            <td>@user.Age</td>
                            <td>@user.DateOfBirth</td>
                            <td>
                                <span class="badge
                                    @(user.Role == "Admin" ? "bg-primary" : "bg-info text-dark") px-3 py-2">
                                    @user.Role
                                </span>
                            </td>
                            <td>
                                <div class="d-flex justify-content-center gap-2">
                                    <a class="btn btn-sm btn-outline-primary px-3"
                                       asp-controller="Account" asp-action="Register" asp-route-id="@user.Id">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-controller="Account" asp-action="DeleteUser" asp-route-id="@user.Id" method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this user?');">
                                        <button type="submit" class="btn btn-sm btn-outline-info text-dark px-3 border-1 border-info">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

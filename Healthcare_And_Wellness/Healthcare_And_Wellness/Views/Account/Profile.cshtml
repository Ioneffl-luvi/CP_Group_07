@model User

@{
    ViewData["Title"] = "Profile";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="card-header text-white d-flex align-items-center justify-content-center"
             style="background: linear-gradient(90deg, #4A90E2, #007BFF); border-bottom: 4px solid #0056b3;">
            <h3 class="mb-0 fw-bold"><i class="bi bi-person-circle me-2"></i> My Profile</h3>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div id="successMessage" class="alert alert-success text-center mb-0 rounded-0">
                @TempData["SuccessMessage"]
            </div>
        }

        <div class="card-body" style="background-color: #f0f4ff;">
            <div class="text-center mb-4">
                @if (!string.IsNullOrEmpty(Model.ProfilePic))
                {
                    <img src="@Url.Action("DisplayProfilePic", "Account", new { id = Model.Id })"
                         alt="Profile Picture"
                         class="rounded-circle border border-3 border-primary shadow"
                         style="width: 150px; height: 150px; object-fit: cover;" />
                }
                else
                {
                    <img src="/ProfilePics/default_user.png"
                         alt="Default Profile Picture"
                         class="rounded-circle border border-3 border-secondary shadow"
                         style="width: 150px; height: 150px; object-fit: cover;" />
                }
            </div>

            <div class="row justify-content-center">
                <div class="col-md-8">
                    <ul class="list-group list-group-flush fs-5">
                        <li class="list-group-item bg-transparent">
                            <i class="bi bi-person-fill me-2 text-primary"></i>
                            <strong>Username:</strong> <span class="ms-2">@Model.Username</span>
                        </li>
                        <li class="list-group-item bg-transparent">
                            <i class="bi bi-card-heading me-2 text-info"></i>
                            <strong>Name:</strong> <span class="ms-2">@Model.Name</span>
                        </li>
                        <li class="list-group-item bg-transparent">
                            <i class="bi bi-calendar-heart me-2 text-success"></i>
                            <strong>Age:</strong> <span class="ms-2">@Model.Age</span>
                        </li>
                        <li class="list-group-item bg-transparent">
                            <i class="bi bi-calendar-check-fill me-2 text-secondary"></i>
                            <strong>Date of Birth:</strong> <span class="ms-2">@Model.DateOfBirth</span>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="text-center mt-5">
                <a asp-action="EditProfile" class="btn btn-lg text-white shadow-sm"
                   style="background: linear-gradient(90deg, #4A90E2, #007BFF); border: none;">
                    <i class="bi bi-pencil-fill me-2"></i> Edit Profile
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        setTimeout(function () {
            var successMessage = document.getElementById("successMessage");
            if (successMessage) {
                successMessage.style.transition = "opacity 0.5s ease";
                successMessage.style.opacity = 0;
                setTimeout(() => successMessage.remove(), 500);
            }
        }, 5000);
    </script>
}
